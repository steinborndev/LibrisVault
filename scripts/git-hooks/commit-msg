#!/usr/bin/env bash
# commit-msg hook - stop private vault content from leaking into this PUBLIC repo's history.
#
# The tooling repo is public; the vault it operates on is private. A commit message must never
# name a specific vault subject (an entity, a person's handle, a source title) - that reveals
# what the private knowledge base contains. The motivating leak (2026-07-22): a commit body
# named two X handles from an entity page.
#
# What it does: builds a denylist of the distinctive names in the vault's entities/, sources/,
# questions/, comparisons/ and folds/ pages - page titles AND their fragments, plus @handles /
# 0x_ handles found inside them - and rejects the commit if the message contains any of them.
#
# Fragments, because whole stems missed a real case: a page titled "<Something> (<Publisher>)"
# put only the whole string on the list, so a message naming the parenthetical alone passed.
# A title is therefore also split on parentheses, colons, dashes and commas, and each part is
# added when it is at least two words long. Single-word fragments are deliberately dropped:
# they are where the false positives live ("biologics", "cooking"), and a single distinctive
# word is usually the whole title anyway, which is on the list in its own right.
#
# NOT on the list, both on purpose:
#   - concepts/, which hold generic reusable knowledge ("Compound Interest") and would
#     false-positive against ordinary technical wording. The cost is real and known: a concept
#     title CAN be vault-revealing, and one was found verbatim in a test fixture (2026-09-15).
#     585 of them against ordinary commit prose is simply the worse trade.
#   - references/, which come from the upstream claude-obsidian repo and are public already
#     (they are the `PROTECTED_WIKI_SCOPES` the agent runner refuses to let a run touch), and
#     meta/, which holds the journals and notebooks - their FILE names are Fellow names from
#     the product's own suggestion list, not anything the vault is about.
#
# WHAT IT STRUCTURALLY CANNOT DO, so nobody trusts it further than it goes:
#   - It scans the commit MESSAGE. File CONTENT goes past it untouched, and content is where
#     every leak found in the 2026-09-15 audit actually was: examples in comments, UI
#     placeholders, test fixtures, and run output quoted into a design record.
#   - `gh pr create` text is not a commit message either, and the PR body is the likeliest
#     leak of all. Check it by hand.
#   - It only knows page TITLES. A standing task's subject lives in SQLite, so a planner
#     answer quoted into a document names things no title ever carried.
#
# Scope: the check only knows about the vault at VAULT_ROOT (env, else ~/vault). No vault
# present (fresh clone, CI, setup mode) -> the hook passes silently, blocking nothing.
#
# Not scanned: comment lines, and git attribution trailers (the `<Word>-by:` form). A
# trailer names who wrote the commit, which is public information about the commit itself,
# not a claim about what the vault holds - and a co-author's email domain kept matching an
# entity page that happens to share the name.
#
# Escape hatch: set ALLOW_VAULT_NAMES=1 for the rare legitimate case (then double-check it
# really is not a leak). Install with scripts/install-git-hooks.sh.
set -euo pipefail

MSG_FILE="$1"
[ -n "${ALLOW_VAULT_NAMES:-}" ] && exit 0

VAULT_ROOT="${VAULT_ROOT:-$HOME/vault}"
[ -d "$VAULT_ROOT/wiki" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

python3 - "$MSG_FILE" "$VAULT_ROOT" <<'PY'
import os, re, sys

msg_file, vault_root = sys.argv[1], sys.argv[2]

# Git attribution trailers: `Co-authored-by:`, `Signed-off-by:`, `Reviewed-by:` and friends.
# Deliberately narrow - only the `<Word>-by:` form, so ordinary prose can never claim the
# exemption by accident. The point is not that trailers are trusted: a trailer names a PERSON
# who worked on the commit, which is public information about the commit, whereas the leak
# this hook exists to stop is a message describing the vault's private SUBJECT MATTER.
TRAILER_RE = re.compile(r"^[A-Za-z][A-Za-z-]*-by:", re.IGNORECASE)

def scanned(line: str) -> bool:
    # Comment lines go too (git strips them anyway) - matching against them would
    # false-positive on the hook's own explanatory text if it were ever pasted in.
    return not line.startswith("#") and TRAILER_RE.match(line) is None

msg = "".join(l for l in open(msg_file, encoding="utf-8", errors="replace") if scanned(l))
msg_low = msg.lower()

# Short/common tokens that are entity names in the vault but also ordinary words: matching
# them would block legitimate commits. Distinctive names (handles, multi-word titles) carry
# the real leak signal, so the cost of skipping these is low.
#
# The second group is this product's OWN vocabulary, which every synthesis page carries as a
# title suffix (`research-profiles.ts`). Splitting titles on the dash puts each lens name on
# the list once per page, so without these three the guard would block any commit discussing
# a lens by name - product terms shipped in this repo, describing nothing about a vault.
STOP = {
    "data", "code", "test", "page", "user", "index", "log", "hot", "meta", "core", "self",
    "state of the art", "patent landscape", "startup landscape",
}

deny = {}  # lowercased term -> canonical form (for the error message)

def add(term: str) -> None:
    t = term.strip(" \t-:,")
    if len(t) < 4:
        return
    low = t.lower()
    if low in STOP:
        return
    deny.setdefault(low, t)

def add_fragment(term: str) -> None:
    """A part of a title. Two words minimum, because one word is where the false positives are."""
    t = term.strip(" \t-:,")
    if len(t.split()) < 2 or len(t) < 8:
        return
    add(t)

# Split a title the way a fixture writer would quote a piece of it: what stands before a
# parenthesis, what stands inside one, and the parts around a colon, a dash or a comma.
SPLIT_RE = re.compile(r"\s+[-\u2013\u2014]\s+|[:,]")

def add_title(stem: str) -> None:
    add(stem)
    depth, buf, parts = 0, [], []
    for ch in stem:
        if ch == "(":
            depth += 1
            if depth == 1:
                parts.append("".join(buf))
                buf = []
                continue
        elif ch == ")":
            depth -= 1
            if depth == 0:
                parts.append("".join(buf))
                buf = []
                continue
        buf.append(ch)
    parts.append("".join(buf))
    for part in parts:
        for piece in SPLIT_RE.split(part):
            add_fragment(piece)

HANDLE_RE = re.compile(r"@[A-Za-z0-9_]{2,}|0x_[A-Za-z0-9]+")

# Every bucket a run writes that says something about what this vault is ABOUT. See the header
# for why concepts/, references/ and meta/ are not here.
for bucket in ("entities", "sources", "questions", "comparisons", "folds"):
    d = os.path.join(vault_root, "wiki", bucket)
    if not os.path.isdir(d):
        continue
    for name in os.listdir(d):
        if not name.endswith(".md") or name.startswith("_"):
            continue
        add_title(name[:-3])  # the page title (filename stem) and its parts
        try:
            body = open(os.path.join(d, name), encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for h in HANDLE_RE.findall(body):
            add(h)

hits = []
for low, canon in deny.items():
    # whole-token, case-insensitive: no leading/trailing word char around the match.
    if re.search(r"(?<!\w)" + re.escape(low) + r"(?!\w)", msg_low):
        hits.append(canon)

if hits:
    uniq = sorted(set(hits), key=str.lower)
    sys.stderr.write(
        "\ncommit-msg blocked: the message names private vault content, which must not\n"
        "leak into this public repo's history:\n"
    )
    for h in uniq:
        sys.stderr.write(f"  - {h}\n")
    sys.stderr.write(
        "\nDescribe the change generically (the mechanism, not the subject). If this is a\n"
        "false positive, re-commit with ALLOW_VAULT_NAMES=1.\n"
    )
    sys.exit(1)
PY
