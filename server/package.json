{
  "name": "@librisvault/server",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Fastify backend: watcher, queue, preprocessing, agent runner",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "pipeline": "tsx src/cli/pipeline.ts",
    "permprobe": "tsx src/cli/permprobe.ts",
    "killprobe": "tsx src/cli/killprobe.ts",
    "smoke": "tsx src/cli/smoke.ts",
    "retrieval-eval": "tsx src/cli/retrieval-eval.ts",
    "dedupe-eval": "tsx src/cli/dedupe-eval.ts",
    "preprocprobe": "tsx src/cli/preprocprobe.ts",
    "vaultprobe": "tsx src/cli/vaultprobe.ts",
    "splitprobe": "tsx src/cli/splitprobe.ts",
    "questionaudit": "tsx src/cli/questionaudit.ts",
    "manifest-backfill": "tsx src/cli/manifest-backfill.ts",
    "rename-unsafe": "tsx src/cli/rename-unsafe-names.ts",
    "questiontopic-eval": "tsx src/cli/questiontopic-eval.ts",
    "vaultrepair": "tsx src/cli/vaultrepair.ts",
    "backfill-quote-evidence": "tsx src/cli/backfill-quote-evidence.ts",
    "quoteprobe": "tsx src/cli/quoteprobe.ts",
    "usageprobe": "tsx src/cli/usageprobe.ts",
    "oasweep": "tsx src/cli/oasweep.ts",
    "readingsweep": "tsx src/cli/readingsweep.ts",
    "backfill-sources": "tsx src/cli/backfill-sources.ts",
    "graph-timelapse": "tsx src/cli/graph-timelapse.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.212",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.3",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.11"
  }
}
